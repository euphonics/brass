{
  "name": "brass",
  "version": "0.3.0",
  "description": "Screenplay-aware writing assistance for Obsidian, with portable Fountain source.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production && npm run check:bundle-size",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "dev": "node esbuild.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:headers": "node scripts/add-license-headers.mjs",
    "license:headers:check": "node scripts/add-license-headers.mjs --check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-vault": "npm run build && node scripts/install-vault.mjs dev",
    "install-notes": "npm run build && node scripts/install-vault.mjs notes",
    "test-vault": "npm run build && node scripts/install-test-vault.mjs"
  },
  "keywords": [
    "obsidian",
    "fountain",
    "screenplay",
    "screenwriting"
  ],
  "author": "arvn",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12 <23 || >=24"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.6",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.14.0",
    "obsidian": "latest",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "linebreak": "2.0.0",
    "pdf-lib": "1.17.1"
  }
}
